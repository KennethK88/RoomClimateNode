@startuml
title Luftüberwachung – Klassendiagramm (bereinigt)

' ===== Klassen =====
class TemperatureSensor
{
    -currentTemperature : float
    +TemperatureSensor()
    +readTemperature() : void
    +getTemperature() : float
}
class HumiditySensor
{
    -currentHumidity : float
    +HumiditySensor()
    +readHumidity() : void
    +getHumidity() : float
}
class COSensor
{
    -currentCO : float
    +COSensor()
    +readCO() : void
    +getCO() : float
}

class SensorCoordinator
{
    -tempSens : TemperatureSensor
    -humSens : HumiditySensor
    -coSens : COSensor
    +SensorCoordinator()
    +readAllSensors() : Measurements
}

class SensorValidator
{
    +SensorValidator()
    +validateAllSensors() : ValidationResult   
} 

class ThresholdEvaluator
{
    +ThresholdEvaluator()
    +evaluateAllSensors() : ThresholdResult
}

class StateMachine
{
    +StateMachine()
    +calculateState() : SystemState
}
class DisplayController
{
    -displayOutput : IDisplayOutput&
    +DisplayController(IDisplayOutput&)
    +updateDisplay(const Measurements&, SystemState) : void
}

class AlarmController
{
    -alarmActive : bool
    -alarmOutput : IAlarmOutput&
    +AlarmController(IAlarmOutput&)
    +updateAlarm(SystemState) : void
    +isAlarmActive() : bool
}

class AirMonitorController
{
    -sensorCoordinator : SensorCoordinator
    -sensorValidator : SensorValidator
    -thresholdEvaluator : ThresholdEvaluator
    -oledDriver : OledDriver
    -displayController : DisplayController
    -stateMachine : StateMachine
    -buzzerDriver : BuzzerDriver
    -ledDriver : LedDriver
    -compositeAlarmOutput : CompositeAlarmOutput
    -alarmController : AlarmController
    +AirMonitorController()
    +init() : void
    +update() : void
}

class BuzzerDriver
{
    +BuzzerDriver()
    +init() : void
    +activate() : void
    +deactivate() : void
}

class LedDriver
{
    +LedDriver()
    +init() : void
    +activate() : void
    +deactivate() : void
}

interface IAlarmOutput
{
    +~IAlarmOutput()
    +activate() : void
    +deactivate() : void
}

class CompositeAlarmOutput
{
    -alarmOutputs : std::vector<IAlarmOutput*>
    +CompositeAlarmOutput()
    +add(IAlarmOutput*) : void
    +activate() : void
    +deactivate() : void
}

interface IDisplayOutput
{
    +~IDisplayOutput()
    +clear() : void
    +writeLine(int line, const char* text) : void
    +display() : void
}

class OledDriver
{
    -oled : U8g2
    +OledDriver()
    +init() : void
    +clear() : void
    +writeLineint(line, const char* text) : void
    +display() : void
}

struct Measurements
struct ValidationResult
struct ThresholdResult
struct SystemState

' ===== Besitz / feste Abhängigkeiten =====
AirMonitorController --> SensorCoordinator
AirMonitorController --> SensorValidator
AirMonitorController --> ThresholdEvaluator
AirMonitorController --> StateMachine
AirMonitorController --> DisplayController
AirMonitorController --> BuzzerDriver
AirMonitorController --> LedDriver
AirMonitorController --> CompositeAlarmOutput
AirMonitorController --> AlarmController
AirMonitorController --> OledDriver

SensorCoordinator --> TemperatureSensor
SensorCoordinator --> HumiditySensor
SensorCoordinator --> COSensor

CompositeAlarmOutput --> "0..*" IAlarmOutput

' ===== Nutzung / Datenfluss =====
SensorValidator ..> Measurements
SensorValidator ..> ValidationResult

ThresholdEvaluator ..> Measurements
ThresholdEvaluator ..> ValidationResult
ThresholdEvaluator ..> ThresholdResult

StateMachine ..> ValidationResult
StateMachine ..> ThresholdResult
StateMachine ..> SystemState

SensorCoordinator ..> Measurements

DisplayController ..> Measurements
DisplayController ..> SystemState
DisplayController ..> IDisplayOutput

AlarmController ..> SystemState
AlarmController ..> IAlarmOutput

IAlarmOutput <|.. BuzzerDriver
IAlarmOutput <|.. LedDriver
IAlarmOutput <|.. CompositeAlarmOutput

IDisplayOutput <|.. OledDriver

@enduml