@startuml
title Luftüberwachung – Klassendiagramm (bereinigt)

' ===== Klassen =====
class TemperatureSensor
{
    -currentTemperature : float
    -sensorDriver : ISensorDriver&
    +TemperatureSensor(ISensorDriver&)
    +readTemperature() : void
    +getTemperature() : float
}
class HumiditySensor
{
    -currentHumidity : float
    -sensorDriver : ISensorDriver&
    +HumiditySensor(ISensorDriver&)
    +readHumidity() : void
    +getHumidity() : float
}
class COSensor
{
    -currentCO : float
    -sensorDriver : ISensorDriver&
    +COSensor(ISensorDriver&)
    +readCO() : void
    +getCO() : float
}

class DistanceSensor
{
    -currentDistance : float
    -sensorDriver : ISensorDriver&
    +DistanceSensor(ISensorDriver&)
    +readDistance() : void
    +getDistance() : float
}

class SensorCoordinator
{
    -tempSens : TemperatureSensor&
    -humSens : HumiditySensor&
    -coSens : COSensor&
    -distanceSensor : DistanceSensor&
    +SensorCoordinator(TemperatureSensor&, HumiditySensor&, COSensor&, DistanceSensor&)
    +readAllSensors() : Measurements
}

class SensorValidator
{
    +SensorValidator()
    +validateAllSensors() : ValidationResults   
} 

class ThresholdEvaluator
{
    +ThresholdEvaluator()
    +evaluateAllSensors() : ThresholdResults
}

class StateMachine
{
    +StateMachine()
    +calculateState() : SystemState
}
class DisplayController
{
    -displayOutput : IDisplayOutput&
    +DisplayController(IDisplayOutput&)
    +updateDisplay(const Measurements&, SystemState, bool displayActive) : void
}

class AlarmController
{
    -alarmActive : bool
    -alarmOutput : IAlarmOutput&
    +AlarmController(IAlarmOutput&)
    +updateAlarm(SystemState) : void
    +isAlarmActive() : bool
}

class AirMonitorController
{
    -thermistorDriver : ThermistorDriver
    -humidityDriver : HumidityDriver
    -coDriver : CODriver
    -distanceDriver : DistanceDriver
    -temperatureSensor : TemperatureSensor
    -humiditySensor : HumiditySensor
    -coSensor : COSensor
    -distanceSensor : DistanceSensor
    -sensorCoordinator : SensorCoordinator
    -displayPolicy : DisplayPolicy
    -sensorValidator : SensorValidator
    -thresholdEvaluator : ThresholdEvaluator
    -oledDriver : OledDriver
    -displayController : DisplayController
    -stateMachine : StateMachine
    -buzzerDriver : BuzzerDriver
    -ledDriver : LedDriver
    -compositeAlarmOutput : CompositeAlarmOutput
    -alarmController : AlarmController
    +AirMonitorController()
    +init() : void
    +update() : void
}

class BuzzerDriver
{
    +BuzzerDriver()
    +init() : void
    +activate() : void
    +deactivate() : void
}

class LedDriver
{
    +LedDriver()
    +init() : void
    +activate() : void
    +deactivate() : void
}

class CompositeAlarmOutput
{
    -alarmOutputs : std::vector<IAlarmOutput*>
    +CompositeAlarmOutput()
    +add(IAlarmOutput*) : void
    +activate() : void
    +deactivate() : void
}

class OledDriver
{
    -oled : U8g2
    +OledDriver()
    +init() : void
    +clear() : void
    +writeLine(int, const char*) : void
    +display() : void
    +sleepOn() : void
    +sleepOff() : void
}

class ThermistorDriver
{
    -readRawValue() : int
    -convertRawValueToTemperature(int) : float
    +ThermistorDriver()
    +init() : void
    +getValue() : float
}

class HumidityDriver
{
    -dht : DHT
    +HumidityDriver()
    +init() : void
    +getValue() : float
}

class CODriver
{
    +CODriver()
    +init() : void
    +getValue() : float
}

class DistanceDriver
{
    -readRawValue() : unsigned long
    -convertRawValueToDistance(unsigned long) : float
    +DistanceDriver()
    +init() : void
    +getValue() : float
}

class DisplayPolicy
{
    -evaluateDisplayState(const Measurements&, const ValidationResults&) : bool
    +DisplayPolicy()
    +isDisplayActive(const Measurements&, const ValidationResults&) : bool
}

' ===== Interfaces =====

interface IAlarmOutput
{
    +~IAlarmOutput()
    +activate() : void
    +deactivate() : void
}


interface IDisplayOutput
{
    +~IDisplayOutput()
    +clear() : void
    +writeLine(int line, const char* text) : void
    +display() : void
    +sleepOn() : void
    +sleepOff() : void
}


interface ISensorDriver
{
    +~ISensorDriver()
    +init() : void
    +getValue() : float
}

' ===== Data Objects =====

struct Measurements
{
  +temperature : float
  +humidity : float
  +co : float
  +distance : float
}
struct ValidationResults
{
    +temperatureValid : bool
    +humidityValid : bool
    +coValid : bool
    +distanceValid : bool 
}
struct ThresholdResults
{
    +temperatureTooHigh : bool
    +humidityTooHigh : bool
    +coTooHigh : bool
    +temperatureTooLow : bool
    +humidityTooLow : bool
}
struct SystemState

' ===== Besitz / feste Abhängigkeiten =====
AirMonitorController --> ThermistorDriver
AirMonitorController --> HumidityDriver
AirMonitorController --> CODriver
AirMonitorController --> DistanceDriver
AirMonitorController --> TemperatureSensor
AirMonitorController --> HumiditySensor
AirMonitorController --> COSensor
AirMonitorController --> DistanceSensor
AirMonitorController --> SensorCoordinator
AirMonitorController --> DisplayPolicy
AirMonitorController --> SensorValidator
AirMonitorController --> ThresholdEvaluator
AirMonitorController --> OledDriver
AirMonitorController --> DisplayController
AirMonitorController --> StateMachine
AirMonitorController --> BuzzerDriver
AirMonitorController --> LedDriver
AirMonitorController --> CompositeAlarmOutput
AirMonitorController --> AlarmController

SensorCoordinator --> TemperatureSensor
SensorCoordinator --> HumiditySensor
SensorCoordinator --> COSensor
SensorCoordinator --> DistanceSensor

CompositeAlarmOutput --> "0..*" IAlarmOutput

' ===== Nutzung / Datenfluss =====
SensorValidator ..> Measurements
SensorValidator ..> ValidationResults

ThresholdEvaluator ..> Measurements
ThresholdEvaluator ..> ValidationResults
ThresholdEvaluator ..> ThresholdResults

StateMachine ..> ValidationResults
StateMachine ..> ThresholdResults
StateMachine ..> SystemState

SensorCoordinator ..> Measurements

DisplayController ..> Measurements
DisplayController ..> SystemState
DisplayController ..> IDisplayOutput

AlarmController ..> SystemState
AlarmController ..> IAlarmOutput

IAlarmOutput <|.. BuzzerDriver
IAlarmOutput <|.. LedDriver
IAlarmOutput <|.. CompositeAlarmOutput

IDisplayOutput <|.. OledDriver

TemperatureSensor ..> ISensorDriver
HumiditySensor ..> ISensorDriver
COSensor ..> ISensorDriver
DistanceSensor ..> ISensorDriver

ISensorDriver <|.. ThermistorDriver
ISensorDriver <|.. HumidityDriver
ISensorDriver <|.. CODriver
ISensorDriver <|.. DistanceDriver

DisplayPolicy ..> Measurements
DisplayPolicy ..> ValidationResults

@enduml