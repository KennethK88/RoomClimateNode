@startuml

title RoomClimateNode - System Architecture

skinparam componentStyle rectangle
skinparam shadowing false

' ============================================================
' RoomClimateNode
' ============================================================

node "RoomClimateNode" as roomNode {

    component "SHT31 Sensor" as sht31
    component "LiPo Battery" as battery

    node "ESP32 MCU\n(LOLIN D32 / C3 Pico)" as esp32 {

        component "RoomClimateNode\nFirmware" as firmware
    }

    sht31 --> esp32 : I2C
    battery --> esp32 : Power supply\nVoltage monitoring via ADC
}

' ============================================================
' Network and Home Assistant
' ============================================================

cloud "Wi-Fi Network" as wifi

node "Raspberry Pi" as pi {

    component "Mosquitto Broker" as broker
    component "Home Assistant" as ha
}

actor "User" as user
actor "OTA Upload Client" as otaClient

firmware <--> wifi : MQTT\nMeasurements, status,\nOTA requests

wifi <--> broker : MQTT over TCP/IP

broker <--> ha : MQTT topics

user <--> ha : Dashboard\nOTA requests

otaClient --> firmware : Firmware upload\nvia Wi-Fi

' ============================================================
' Notes
' ============================================================

note right of roomNode
    Measures:
    - Room temperature
    - Relative humidity
    - Battery level

    Publishes:
    - Sensor measurements
    - Firmware version
    - OTA maintenance window status

    Power management:
    - Timer-based deep sleep
    - 15-minute sleep interval

    OTA:
    - MQTT-controlled OTA requests
    - Temporary maintenance window
    - Wireless firmware upload
end note

@enduml