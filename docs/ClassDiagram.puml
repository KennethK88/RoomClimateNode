@startuml
title RoomClimateNode – Class Diagram

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
hide empty members

' ============================================================
' RoomClimateNode application
' ============================================================

package "RoomClimateNode" {

    package "Application" {
        class RoomClimateFactory {
            +getRoomClimateController() : RoomClimateController&
        }

        class RoomClimateController {
            +init() : void
            +update() : void
        }
    }

    package "Sensors and drivers" {
        interface ISht31SensorDriver {
            +init() : void
            +readMeasurements() : void
            +getTemperature() : Temperature
            +getHumidity() : Humidity
        }

        class Sht31Driver {
            +init() : void
            +readMeasurements() : void
            +getTemperature() : Temperature
            +getHumidity() : Humidity
        }

        class TemperatureSensor {
            +getTemperature() : Temperature
        }

        class HumiditySensor {
            +getHumidity() : Humidity
        }

        class SensorCoordinator {
            +readAllSensors() : Measurements
        }
    }

    package "Data" {
        struct Measurements {
            +temperature : Temperature
            +humidity : Humidity
            +batteryLevel : BatteryLevel
        }

        struct ValidationResults {
            +temperatureValid : bool
            +humidityValid : bool
            +batteryLevelValid : bool
        }
    }

    package "Evaluation" {
        class SensorValidator {
            +validateAllSensors(measurements : const Measurements&) : ValidationResults
        }
    }

    package "MQTT publishing" {
        class MqttMeasurementPublisher {
            +publish(measurements : const Measurements&) : bool
        }
    }

    package "Power" {
        class PowerManager {
            -configureWakeUp() : bool
            +enterDeepSleep() : void
        }
    }
}

' ============================================================
' Reusable components from the separate EmbeddedNodeLibs repo
' ============================================================

package "EmbeddedNodeLibs (external)" {

    package "Battery" {
        interface IBatteryDriver {
            +init() : void
            +readVoltage() : void
            +getVoltage() : BatteryVoltage
        }

        class ESP32BatteryDriver {
            +init() : void
            +readVoltage() : void
            +getVoltage() : BatteryVoltage
        }

        class BatterySensor {
            +getBatteryLevel() : BatteryLevel
        }
    }

    package "Connectivity" {
        class WiFiConnectionManager {
            +init() : void
            +connect() : void
            +isConnected() : bool
        }

        class MqttClientService {
            +init() : void
            +connect() : void
            +isConnected() : bool
            +publish(topic, payload, retain) : bool
            +disconnect() : void
        }
    }

    package "Firmware and OTA" {
        class FirmwareUpdateService {
            +init() : bool
            +runMaintenanceWindow() : bool
        }

        class MqttOtaRequestReader {
            +subscribe() : bool
            +update() : bool
            +isOtaRequested() : bool
        }

        class MqttOtaStatusPublisher {
            +publishWindowOpen() : bool
            +publishWindowClosed() : bool
        }

        class MqttFirmwareVersionPublisher {
            +publishFirmwareVersion()
        }
    }
}

' ============================================================
' Interface implementations
' ============================================================

ISht31SensorDriver <|.. Sht31Driver
IBatteryDriver <|.. ESP32BatteryDriver

' ============================================================
' Ownership: factory owns concrete components and controller
' ============================================================

RoomClimateFactory *-- RoomClimateController
RoomClimateFactory *-- Sht31Driver
RoomClimateFactory *-- ESP32BatteryDriver
RoomClimateFactory *-- WiFiConnectionManager
RoomClimateFactory *-- MqttClientService
RoomClimateFactory *-- MqttMeasurementPublisher
RoomClimateFactory *-- PowerManager
RoomClimateFactory *-- FirmwareUpdateService
RoomClimateFactory *-- MqttOtaRequestReader
RoomClimateFactory *-- MqttOtaStatusPublisher
RoomClimateFactory *-- MqttFirmwareVersionPublisher

' ============================================================
' Ownership: application-level objects live inside controller
' ============================================================

RoomClimateController *-- TemperatureSensor
RoomClimateController *-- HumiditySensor
RoomClimateController *-- BatterySensor
RoomClimateController *-- SensorCoordinator
RoomClimateController *-- SensorValidator

' ============================================================
' Injected references held by controller
' ============================================================

RoomClimateController --> ISht31SensorDriver
RoomClimateController --> IBatteryDriver
RoomClimateController --> WiFiConnectionManager
RoomClimateController --> MqttClientService
RoomClimateController --> MqttMeasurementPublisher
RoomClimateController --> PowerManager
RoomClimateController --> FirmwareUpdateService
RoomClimateController --> MqttOtaRequestReader
RoomClimateController --> MqttOtaStatusPublisher
RoomClimateController --> MqttFirmwareVersionPublisher

' ============================================================
' Sensor dependencies and measurement data flow
' ============================================================

TemperatureSensor --> ISht31SensorDriver
HumiditySensor --> ISht31SensorDriver
BatterySensor --> IBatteryDriver

SensorCoordinator --> TemperatureSensor
SensorCoordinator --> HumiditySensor
SensorCoordinator --> BatterySensor
SensorCoordinator ..> Measurements

SensorValidator ..> Measurements
SensorValidator ..> ValidationResults

MqttMeasurementPublisher --> MqttClientService
MqttMeasurementPublisher ..> Measurements

' ============================================================
' MQTT dependencies of reusable services
' ============================================================

MqttOtaRequestReader --> MqttClientService
MqttOtaStatusPublisher --> MqttClientService
MqttFirmwareVersionPublisher --> MqttClientService


note right of SensorValidator
  Validation results are currently not used
  to control MQTT measurement publishing.
end note

@enduml