@startuml
title RoomClimateNode – Class Diagram

skinparam classAttributeIconSize 0

' ============================================================
' Data / Common
' ============================================================

package "data" {

    struct Measurements {
        +temperature : Temperature
        +humidity : Humidity
        +batteryLevel : BatteryLevel
    }

    struct ValidationResults {
        +temperatureValid : bool
        +humidityValid : bool
        +batteryLevelValid : bool
    }

    enum SystemState {
        Normal
        Error
    }
}

' ============================================================
' Communication Interfaces
' ============================================================

package "communication" {

    interface IConnectionManager {
        +init() : void
        +connect() : void
        +reconnect() : void
        +isConnected() : bool
    }

    interface IMeasurementPublisher {
        +publish(measurements : const Measurements&) : void
    }
}

' ============================================================
' Sensor Interfaces / Sensor Abstractions
' ============================================================

package "sensors" {

    interface ISht31SensorDriver {
        +init() : void
        +readMeasurements() : void
        +getTemperature() : Temperature
        +getHumidity() : Humidity
    }

    interface IBatteryDriver {
        +init() : void
        +readVoltage() : void
        +getVoltage() : BatteryVoltage
    }

    class TemperatureSensor {
        -sht31SensorDriver : ISht31SensorDriver&
        +TemperatureSensor(sht31SensorDriver : ISht31SensorDriver&)
        +getTemperature() : Temperature
    }

    class HumiditySensor {
        -sht31SensorDriver : ISht31SensorDriver&
        +HumiditySensor(sht31SensorDriver : ISht31SensorDriver&)
        +getHumidity() : Humidity
    }

    class BatterySensor {
        -batteryDriver : IBatteryDriver&
        +BatterySensor(batteryDriver : IBatteryDriver&)
        +getBatteryLevel() : BatteryLevel
    }

    class SensorCoordinator {
        -temperatureSensor : TemperatureSensor&
        -humiditySensor : HumiditySensor&
        -batterySensor : BatterySensor&
        +SensorCoordinator(temperatureSensor : TemperatureSensor&, humiditySensor : HumiditySensor&, batterySensor : BatterySensor&)
        +readAllSensors() : Measurements
    }
}

' ============================================================
' Evaluation
' ============================================================

package "evaluation" {

    class SensorValidator {
        +SensorValidator()
        +validateAllSensors(measurements : const Measurements&) : ValidationResults
    }

    class StateMachine {
        +StateMachine()
        +calculateState(validationResults : const ValidationResults&) : SystemState
    }
}

' ============================================================
' Drivers
' ============================================================

package "drivers" {

    class Sht31Driver {
        -data : uint8_t[6]
        -temperature : Temperature
        -humidity : Humidity
        +Sht31Driver()
        +init() : void
        +readMeasurements() : void
        +getTemperature() : Temperature
        +getHumidity() : Humidity
    }

    class ESP32BatteryDriver {
        -batteryVoltage : BatteryVoltage
        +ESP32BatteryDriver()
        +init() : void
        +readVoltage() : void
        +getVoltage() : BatteryVoltage
    }
}

' ============================================================
' Connectivity
' ============================================================

package "connectivity" {

    class WiFiConnectionManager {
        +WiFiConnectionManager()
        +init() : void
        +connect() : void
        +reconnect() : void
        +isConnected() : bool
    }

    class MqttClientService {
        -wifiClient : WiFiClient
        -mqttClient : MqttClient
        +MqttClientService()
        +init() : void
        +connect() : void
        +reconnect() : void
        +isConnected() : bool
        +publish(topic : const char*, payload : const char*) : bool
    }

    class MqttMeasurementPublisher {
        -mqttClientService : MqttClientService&
        +MqttMeasurementPublisher(mqttClientService : MqttClientService&)
        +publish(measurements : const Measurements&) : void
    }
}

' ============================================================
' Controller / Factory
' ============================================================

package "controller" {

    class AirMonitorController {
        -sht31SensorDriver : ISht31SensorDriver&
        -batteryDriver : IBatteryDriver&
        -wifiConnectionManager : IConnectionManager&
        -mqttClientService : IConnectionManager&
        -measurementPublisher : IMeasurementPublisher&
        -temperatureSensor : TemperatureSensor
        -humiditySensor : HumiditySensor
        -batterySensor : BatterySensor
        -sensorCoordinator : SensorCoordinator
        -sensorValidator : SensorValidator
        -stateMachine : StateMachine
        +AirMonitorController(sht31SensorDriver : ISht31SensorDriver&, batteryDriver : IBatteryDriver&, wifiConnectionManager : IConnectionManager&, mqttClientService : IConnectionManager&, measurementPublisher : IMeasurementPublisher&)
        +init() : void
        +update() : void
    }
}

package "factory" {

    class AirMonitorFactory {
        -sht31Driver : Sht31Driver
        -esp32BatteryDriver : ESP32BatteryDriver
        -wifiConnectionManager : WiFiConnectionManager
        -mqttClientService : MqttClientService
        -mqttMeasurementPublisher : MqttMeasurementPublisher
        -airMonitorController : AirMonitorController
        +getAirMonitorController() : AirMonitorController&
    }
}

' ============================================================
' Interface Implementations
' ============================================================

ISht31SensorDriver <|.. Sht31Driver
IBatteryDriver <|.. ESP32BatteryDriver

IConnectionManager <|.. WiFiConnectionManager
IConnectionManager <|.. MqttClientService

IMeasurementPublisher <|.. MqttMeasurementPublisher

' ============================================================
' Ownership / Composition
' ============================================================

AirMonitorController *-- TemperatureSensor
AirMonitorController *-- HumiditySensor
AirMonitorController *-- BatterySensor
AirMonitorController *-- SensorCoordinator
AirMonitorController *-- SensorValidator
AirMonitorController *-- StateMachine

AirMonitorFactory *-- Sht31Driver
AirMonitorFactory *-- ESP32BatteryDriver
AirMonitorFactory *-- WiFiConnectionManager
AirMonitorFactory *-- MqttClientService
AirMonitorFactory *-- MqttMeasurementPublisher
AirMonitorFactory *-- AirMonitorController

' ============================================================
' Dependencies / Data Flow
' ============================================================

TemperatureSensor --> ISht31SensorDriver
HumiditySensor --> ISht31SensorDriver
BatterySensor --> IBatteryDriver

SensorCoordinator --> TemperatureSensor
SensorCoordinator --> HumiditySensor
SensorCoordinator --> BatterySensor
SensorCoordinator ..> Measurements

SensorValidator ..> Measurements
SensorValidator ..> ValidationResults

StateMachine ..> ValidationResults
StateMachine ..> SystemState

MqttMeasurementPublisher --> MqttClientService
MqttMeasurementPublisher ..> Measurements

AirMonitorController --> ISht31SensorDriver
AirMonitorController --> IBatteryDriver
AirMonitorController --> IConnectionManager
AirMonitorController --> IMeasurementPublisher
AirMonitorController ..> Measurements
AirMonitorController ..> ValidationResults
AirMonitorController ..> SystemState

@enduml